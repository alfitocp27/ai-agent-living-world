# ── AI Agent Living World — environment ──────────────────────────────────────
# Salin ke .env (frontend) / server/.env (backend). JANGAN commit file .env.
# Secret API HANYA di server/.env — tidak pernah di VITE_* atau di browser.

# Frontend (Vite) — opsional di Fase 1 (demo berjalan tanpa backend)
VITE_ORCHESTRATOR_URL=http://localhost:8787

# Backend orchestrator (server/index.mjs)
# PROVIDER=muse    # pakai Muse (muse.ai) — tanpa API key, tugas masuk antrean asisten
# PROVIDER=demo    # simulasi deterministik (default bila PROVIDER tidak diisi & tanpa key)
# PROVIDER=openai  # butuh PROVIDER_API_KEY di bawah (OpenAI-compatible)
# PROVIDER_API_KEY=sk-...
# PROVIDER_BASE_URL=https://api.openai.com/v1
# PROVIDER_MODEL=gpt-5-mini
# PORT=8787
# CORS_ORIGIN=http://localhost:5173

# Supabase (Fase 3 — belum terhubung di Fase 1)
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...   # server saja, JANGAN di frontend
